<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".UserLogin">

    <ScrollView
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="60dp"
            android:paddingBottom="24dp">

            <!-- Logo / İkon Alanı
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp"
                android:src="@drawable/applogo"
                android:background="@drawable/edittext_bg"
                android:padding="12dp"
                android:contentDescription="Uygulama Logosu" />
            -->


                <ImageView
                    android:id="@+id/center_logo"
                    android:focusable="true"
                    android:layout_gravity="center"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/applogo"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="14dp"
                    android:contentDescription="Center Logo"/>

            <!-- Başlık Alanı -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tekrar Hoş Geldiniz"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hesabınıza giriş yapın"
                android:textSize="14sp"
                android:textColor="#9E9E9E"
                android:layout_gravity="center"
                android:layout_marginBottom="40dp" />

            <!-- E-Posta -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="E-Posta"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editTextEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Mail adresinizi giriniz"
                android:textSize="15sp"
                android:layout_marginBottom="16dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/edittext_bg"
                android:textColor="#1A1A2E"
                android:inputType="textEmailAddress" />

            <!-- Şifre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şifre"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/editTextPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Şifrenizi giriniz"
                android:textSize="15sp"
                android:layout_marginBottom="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:background="@drawable/edittext_bg"
                android:textColor="#1A1A2E"
                android:inputType="textPassword" />

            <!-- Şifremi Unuttum -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Şifremi Unuttum"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#4CAF50"
                android:layout_gravity="end"
                android:layout_marginBottom="32dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />

            <!-- Giriş Yap Butonu -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="Giriş Yap"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#4CAF50"
                android:onClick="btnLogin" />

            <!-- Ayırıcı -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E0E0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  veya  "
                    android:textSize="13sp"
                    android:textColor="#9E9E9E" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#E0E0E0" />

            </LinearLayout>

            <!-- Kayıt Ol Yönlendirme -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hesabın yok mu? "
                    android:textSize="14sp"
                    android:textColor="#9E9E9E" />

                <TextView
                    android:id="@+id/tvGoToRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kayıt Ol"
                    android:clickable="true"
                    android:onClick="btnUserRegister"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4CAF50" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>


    <include
        android:id="@+id/navBarInclude" layout="@layout/nav_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>