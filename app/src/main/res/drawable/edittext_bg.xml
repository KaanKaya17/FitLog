<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Focus olunca -->
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/surface"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="2dp"
                android:color="@color/brand_green"/>
            <padding
                android:left="12dp"
                android:right="12dp"
                android:top="12dp"
                android:bottom="12dp"/>
        </shape>
    </item>

    <!-- Normal -->
    <item>
        <shape>
            <solid android:color="@color/surface_input"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/outline"/>
            <padding
                android:left="12dp"
                android:right="12dp"
                android:top="12dp"
                android:bottom="12dp"/>
        </shape>
    </item>

</selector>